    "    theta_index: parameter_order[theta_index]\n",
    "    for theta_index in ACTIVE_SET\n",
    "}\n",
    "\n",
    "\n",
    "def reduced_statevector_from_theta(theta):\n",
    "    \"\"\"Avalia o circuito com apenas os sete parâmetros simbólicos restantes.\"\"\"\n",
    "    theta = np.asarray(theta, dtype=float)\n",
    "    binding = {\n",
    "        active_parameter_objects[theta_index]: float(theta[theta_index])\n",
    "        for theta_index in ACTIVE_SET\n",
    "    }\n",
    "    assigned = reduced_ansatz.assign_parameters(binding, inplace=False)\n",
    "    return np.asarray(Statevector.from_instruction(assigned).data, dtype=np.complex128)\n",
    "\n",
    "\n",
    "reduced_circuit_rows = []\n",
    "if RUN_REDUCED_CIRCUIT_TESTS:\n",
    "    for trial_index in range(REDUCED_CIRCUIT_TRIALS):\n",
    "        rng = np.random.default_rng(RANDOM_SEED + 24_000_000 + trial_index)\n",
    "        theta_test = random_theta_from_periods(rng)\n",
    "        full_state = statevector_from_theta(theta_test)\n",
    "        reduced_state = reduced_statevector_from_theta(theta_test)\n",
    "        comparison = compare_statevectors(reduced_state, full_state)\n",
    "        reduced_circuit_rows.append({\n",
    "            \"trial_index\": int(trial_index),\n",
    "            **comparison,\n",
    "        })\n",
    "\n",
    "reduced_circuit_equivalence_df = pd.DataFrame(reduced_circuit_rows)\n",
    "reduced_circuit_equivalence_summary_df = pd.DataFrame()\n",
    "reduced_circuit_complexity_df = pd.DataFrame()\n",
    "\n",
    "if not reduced_circuit_equivalence_df.empty:\n",
    "    reduced_circuit_equivalence_summary_df = pd.DataFrame([\n",
    "        {\n",
    "            \"n_trials\": int(len(reduced_circuit_equivalence_df)),\n",
    "            \"fidelity_median\": float(reduced_circuit_equivalence_df[\"fidelity\"].median()),\n",
    "            \"fidelity_min\": float(reduced_circuit_equivalence_df[\"fidelity\"].min()),\n",
    "            \"phase_aligned_distance_max\": float(reduced_circuit_equivalence_df[\"phase_aligned_state_distance\"].max()),\n",
    "            \"probability_tvd_max\": float(reduced_circuit_equivalence_df[\"probability_tvd\"].max()),\n",
    "            \"phase_rms_max\": float(reduced_circuit_equivalence_df[\"phase_rms_on_support\"].max()),\n",
    "        }\n",
    "    ])\n",
    "    display(reduced_circuit_equivalence_summary_df)\n",
    "\n",
    "    # Transpila os circuitos simbólicos. O circuito reduzido já possui 23 ângulos\n",
    "    # fixados em zero; a otimização pode eliminar as operações correspondentes.\n",
    "    transpile_seed = RANDOM_SEED + 24_900_000\n",
    "    full_transpiled = transpile(\n",
    "        ansatz,\n",
    "        basis_gates=[\"u\", \"cx\"],\n",
    "        optimization_level=REDUCED_CIRCUIT_TRANSPILE_LEVEL,\n",
    "        seed_transpiler=transpile_seed,\n",
    "    )\n",
    "    reduced_transpiled = transpile(\n",
    "        reduced_ansatz,\n",
    "        basis_gates=[\"u\", \"cx\"],\n",
    "        optimization_level=REDUCED_CIRCUIT_TRANSPILE_LEVEL,\n",
    "        seed_transpiler=transpile_seed,\n",
    "    )\n",
    "\n",
