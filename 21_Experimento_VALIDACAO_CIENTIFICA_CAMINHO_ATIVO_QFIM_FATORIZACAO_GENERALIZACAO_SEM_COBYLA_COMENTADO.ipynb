    "                        \"objective\": float(valid_objectives[valid_position]),\n",
    "                        \"theta_index\": int(theta_index),\n",
    "                        \"base_probability\": float(base_probability[valid_position]),\n",
    "                        \"probability_response\": float(response[valid_position, theta_index]),\n",
    "                        \"first_difference\": float(first_difference[valid_position, theta_index]),\n",
    "                        \"second_difference\": float(second_difference[valid_position, theta_index]),\n",
    "                    })\n",
    "            print(f\"atlas dos 210 bitstrings: {regime}, ponto {point_index}\")\n",
    "\n",
    "target_response_df = pd.DataFrame(target_response_rows)\n",
    "target_parameter_response_summary_df = pd.DataFrame()\n",
    "target_active_path_summary_df = pd.DataFrame()\n",
    "\n",
    "if not target_response_df.empty:\n",
    "    target_parameter_response_summary_df = target_response_df.groupby(\n",
    "        [\"regime\", \"bitstring_qiskit_order\", \"valid_rank\", \"objective\", \"theta_index\"],\n",
    "        as_index=False,\n",
    "    ).agg(\n",
    "        response_median=(\"probability_response\", \"median\"),\n",
    "        response_max=(\"probability_response\", \"max\"),\n",
    "        first_difference_abs_max=(\"first_difference\", lambda s: float(np.max(np.abs(s)))),\n",
    "        second_difference_abs_max=(\"second_difference\", lambda s: float(np.max(np.abs(s)))),\n",
    "        base_probability_median=(\"base_probability\", \"median\"),\n",
    "    )\n",
    "\n",
    "    maximum_by_target = target_parameter_response_summary_df.groupby(\n",
    "        [\"regime\", \"bitstring_qiskit_order\"]\n",
    "    )[\"response_max\"].transform(\"max\")\n",
    "    target_parameter_response_summary_df[\"relative_response\"] = (\n",
    "        target_parameter_response_summary_df[\"response_max\"]\n",
    "        / np.maximum(maximum_by_target, TARGET_RESPONSE_ABS_THRESHOLD)\n",
    "    )\n",
    "    target_parameter_response_summary_df[\"is_responsive\"] = (\n",
    "        target_parameter_response_summary_df[\"response_max\"].ge(TARGET_RESPONSE_ABS_THRESHOLD)\n",
    "        & target_parameter_response_summary_df[\"relative_response\"].ge(TARGET_RESPONSE_REL_THRESHOLD)\n",
    "    )\n",
    "\n",
    "    path_rows = []\n",
    "    for (regime, bitstring), group in target_parameter_response_summary_df.groupby(\n",
    "        [\"regime\", \"bitstring_qiskit_order\"]\n",
    "    ):\n",
    "        responsive = tuple(sorted(\n",
    "            group.loc[group[\"is_responsive\"], \"theta_index\"].astype(int).tolist()\n",
    "        ))\n",
    "        target_row = group.iloc[0]\n",
    "        path_rows.append({\n",
    "            \"regime\": regime,\n",
    "            \"bitstring_qiskit_order\": bitstring,\n",
    "            \"valid_rank\": int(target_row[\"valid_rank\"]),\n",
    "            \"objective\": float(target_row[\"objective\"]),\n",
    "            \"n_responsive_parameters\": int(len(responsive)),\n",
    "            \"responsive_parameters\": responsive,\n",
    "        })\n",
    "    target_active_path_summary_df = pd.DataFrame(path_rows).sort_values(\n",
    "        [\"regime\", \"valid_rank\"]\n",
    "    ).reset_index(drop=True)\n",
    "\n",
    "    optimal_bitstring = str(exact_qiskit_bitstrings[0])\n",
    "    optimal_core = target_active_path_summary_df.loc[\n",
    "        target_active_path_summary_df[\"regime\"].eq(\"core_anchors\")\n",
    "        & target_active_path_summary_df[\"bitstring_qiskit_order\"].eq(optimal_bitstring)\n",
    "    ]\n",
    "    if not optimal_core.empty:\n",
    "        detected = set(optimal_core.iloc[0][\"responsive_parameters\"])\n",
    "        expected = set(ACTIVE_SET)\n",
    "        jaccard = len(detected & expected) / max(len(detected | expected), 1)\n",
    "        display(Markdown(\n",
    "            \"**Conferência do alvo ótimo no núcleo:** parâmetros detectados = \"\n",
    "            f\"`{sorted(detected)}`; núcleo esperado = `{sorted(expected)}`; \"\n",
    "            f\"Jaccard = **{jaccard:.3f}**.\"\n",
    "        ))\n",
    "\n",
    "    # Heatmap do regime core: bitstrings em ordem de energia e parâmetros nas colunas.\n",
    "    core_map = target_parameter_response_summary_df.loc[\n",
    "        target_parameter_response_summary_df[\"regime\"].eq(\"core_anchors\")\n",
    "    ].pivot_table(\n",
    "        index=\"valid_rank\",\n",
    "        columns=\"theta_index\",\n",
    "        values=\"relative_response\",\n",
    "        aggfunc=\"max\",\n",
    "        fill_value=0.0,\n",
    "    ).sort_index()\n",
    "    fig, ax = plt.subplots(figsize=(12, 8))\n",
    "    image = ax.imshow(core_map.to_numpy(dtype=float), origin=\"upper\", aspect=\"auto\", vmin=0.0, vmax=1.0)\n",
    "    ax.set_xlabel(\"theta_index\")\n",
    "    ax.set_ylabel(\"rank clássico do bitstring\")\n",
    "    ax.set_title(\"Resposta relativa dos 210 bitstrings — região do núcleo\")\n",
    "    fig.colorbar(image, ax=ax, label=\"resposta relativa\")\n",
    "    fig.tight_layout()\n",
    "    fig.savefig(FIGURE_DIR / \"all_210_bitstrings_parameter_response_heatmap.png\", dpi=180)\n",
    "    plt.show()\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Derivadas mistas de log P(x*) — teste diferencial da fatorização.\n",
    "# ------------------------------------------------------------\n",
    "log_mixed_rows = []\n",
    "if RUN_LOG_MIXED_DERIVATIVE_TEST:\n",
    "    target_index = int(optimal_indices[0])\n",
    "    for point_index in range(LOG_MIXED_DERIVATIVE_POINTS):\n",
    "        rng = np.random.default_rng(RANDOM_SEED + 22_500_000 + point_index)\n",
    "        theta_reference = active_core_theta_by_anchor[\n",
    "            int(point_index % len(anchors_df))\n",
    "        ].copy()\n",
    "        # Afasta o ponto dos zeros e máximos exatos para tornar log P numericamente útil.\n",
    "        for theta_index in ACTIVE_SET:\n",
    "            theta_reference[theta_index] = rng.uniform(\n",
    "                0.05 * parameter_period(theta_index),\n",
    "                0.95 * parameter_period(theta_index),\n",
    "            )\n",
    "\n",
    "        for theta_i, theta_j in combinations(ACTIVE_SET, 2):\n",
    "            step_i = LOG_MIXED_DERIVATIVE_STEP_FRACTION * parameter_period(theta_i)\n",
    "            step_j = LOG_MIXED_DERIVATIVE_STEP_FRACTION * parameter_period(theta_j)\n",
    "            log_values = {}\n",
    "            reliable = True\n",
    "            for sign_i, sign_j in product((-1, 1), repeat=2):\n",
    "                theta_test = theta_reference.copy()\n",
    "                theta_test[theta_i] = (\n",
    "                    theta_test[theta_i] + sign_i * step_i\n",
    "                ) % parameter_period(theta_i)\n",
    "                theta_test[theta_j] = (\n",
    "                    theta_test[theta_j] + sign_j * step_j\n",
    "                ) % parameter_period(theta_j)\n",
    "                state = statevector_from_theta(theta_test)\n",
    "                probability = float(np.abs(state[target_index]) ** 2)\n",
    "                if probability <= LOG_MIXED_PROBABILITY_FLOOR:\n",
    "                    reliable = False\n",
    "                log_values[(sign_i, sign_j)] = float(\n",
    "                    np.log(max(probability, LOG_MIXED_PROBABILITY_FLOOR))\n",
    "                )\n",
    "\n",
    "            mixed = (\n",
    "                log_values[(1, 1)]\n",
    "                - log_values[(1, -1)]\n",
    "                - log_values[(-1, 1)]\n",
    "                + log_values[(-1, -1)]\n",
    "            ) / (4.0 * step_i * step_j)\n",
    "            log_mixed_rows.append({\n",
    "                \"point_index\": int(point_index),\n",
    "                \"theta_i\": int(theta_i),\n",
    "                \"theta_j\": int(theta_j),\n",
    "                \"mixed_log_derivative\": float(mixed),\n",
    "                \"absolute_mixed_log_derivative\": float(abs(mixed)),\n",
    "                \"reliable\": bool(reliable),\n",
    "            })\n",
    "\n",
    "log_mixed_derivative_df = pd.DataFrame(log_mixed_rows)\n",
    "log_mixed_derivative_summary_df = pd.DataFrame()\n",
    "if not log_mixed_derivative_df.empty:\n",
    "    log_mixed_derivative_summary_df = log_mixed_derivative_df.groupby(\n",
    "        [\"theta_i\", \"theta_j\"], as_index=False\n",
    "    ).agg(\n",
    "        n_points=(\"point_index\", \"count\"),\n",
    "        reliable_fraction=(\"reliable\", \"mean\"),\n",
    "        absolute_mixed_median=(\"absolute_mixed_log_derivative\", \"median\"),\n",
    "        absolute_mixed_q95=(\"absolute_mixed_log_derivative\", lambda s: float(s.quantile(0.95))),\n",
    "        absolute_mixed_max=(\"absolute_mixed_log_derivative\", \"max\"),\n",
    "    )\n",
    "    display(log_mixed_derivative_summary_df)\n"
