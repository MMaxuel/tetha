# ============================================================
# AUDITORIA FINAL — 20.22A v2
# Verifica se a obtenção e organização dos dados ficou completa
# ============================================================

from pathlib import Path
import pandas as pd

ROOT = Path("20_22A_yahoo_dataset_v2")

folders = [
    "00_registry",
    "01_raw",
    "02_processed",
    "03_splits",
    "04_instances",
    "05_manifests",
]

print("=" * 80)
print("AUDITORIA 20.22A v2")
print("=" * 80)

for folder in folders:
    p = ROOT / folder

    files = [
        f for f in p.rglob("*")
        if f.is_file()
    ]

    total_mb = sum(f.stat().st_size for f in files) / 1024**2

    print(
        f"{folder:20s} "
        f"| arquivos = {len(files):5d} "
        f"| tamanho = {total_mb:10.2f} MB"
    )

print("\n" + "=" * 80)
print("CSV / PARQUET encontrados")
print("=" * 80)

data_files = sorted(
    list(ROOT.rglob("*.csv")) +
    list(ROOT.rglob("*.parquet"))
)

for f in data_files:
    try:
        if f.suffix == ".csv":
            df = pd.read_csv(f)
        else:
            df = pd.read_parquet(f)

        print(
            f"{str(f.relative_to(ROOT)):70s} "
            f"{df.shape}"
        )

    except Exception as exc:
        print(
            f"ERRO | {f.relative_to(ROOT)} | {exc}"
        )

print("\nTotal de arquivos tabulares:", len(data_files))
