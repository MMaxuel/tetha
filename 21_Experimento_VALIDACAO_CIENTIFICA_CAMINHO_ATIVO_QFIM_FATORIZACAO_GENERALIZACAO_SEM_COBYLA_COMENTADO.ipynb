    "        }\n",
    "        reduced_bound = reduced_ansatz.assign_parameters(reduced_binding, inplace=False)\n",
    "\n",
    "        for cx_error in AER_CX_DEPOLARIZING_PROBABILITIES:\n",
    "            noise_model = NoiseModel()\n",
    "            noise_model.add_all_qubit_quantum_error(\n",
    "                depolarizing_error(float(cx_error), 2),\n",
    "                [\"cx\"],\n",
    "            )\n",
    "            simulator = AerSimulator(noise_model=noise_model)\n",
    "            for circuit_label, circuit in ((\"full\", full_bound), (\"reduced\", reduced_bound)):\n",
    "                measured = circuit.copy()\n",
    "                measured.measure_all()\n",
    "                compiled = transpile(\n",
    "                    measured,\n",
    "                    simulator,\n",
    "                    basis_gates=[\"u\", \"cx\"],\n",
    "                    optimization_level=REDUCED_CIRCUIT_TRANSPILE_LEVEL,\n",
    "                    seed_transpiler=RANDOM_SEED,\n",
    "                )\n",
    "                result = simulator.run(\n",
    "                    compiled,\n",
    "                    shots=AER_NOISE_SHOTS,\n",
    "                    seed_simulator=RANDOM_SEED,\n",
    "                ).result()\n",
    "                counts = result.get_counts()\n",
    "                p_optimal = sum(\n",
    "                    counts.get(bitstring, 0)\n",
    "                    for bitstring in exact_qiskit_bitstrings\n",
    "                ) / AER_NOISE_SHOTS\n",
    "                aer_noise_rows.append({\n",
    "                    \"circuit\": circuit_label,\n",
    "                    \"cx_depolarizing_probability\": float(cx_error),\n",
    "                    \"shots\": int(AER_NOISE_SHOTS),\n",
    "                    \"p_optimal\": float(p_optimal),\n",
    "                    \"depth\": int(compiled.depth()),\n",
    "                    \"cx_count\": int(compiled.count_ops().get(\"cx\", 0)),\n",
    "                })\n",
    "    except Exception as error:\n",
    "        aer_noise_status = f\"failed: {type(error).__name__}: {error}\"\n",
    "        warnings.warn(aer_noise_status)\n",
    "\n",
    "aer_noise_df = pd.DataFrame(aer_noise_rows)\n",
    "if not aer_noise_df.empty:\n",
    "    display(aer_noise_df)\n",
    "print(\"Aer noise status:\", aer_noise_status)\n"
   ]
