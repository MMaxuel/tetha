  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e3dd6f86",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 33. ESCALONAMENTO ESTRUTURAL PARA OUTROS (n,k)\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def circuit_statevector(circuit, theta):\n",
    "    \"\"\"Statevector de um circuito genérico com parâmetros em sua ordem interna.\"\"\"\n",
    "    theta = np.asarray(theta, dtype=float)\n",
    "    if len(theta) != circuit.num_parameters:\n",
    "        raise ValueError(\"Dimensão de theta incompatível com o circuito genérico.\")\n",
    "    assigned = circuit.assign_parameters(theta, inplace=False)\n",
    "    return np.asarray(Statevector.from_instruction(assigned).data, dtype=np.complex128)\n",
    "\n",
    "\n",
    "def generic_qfim(circuit, theta, step=QFIM_FINITE_DIFFERENCE_STEP):\n",
    "    \"\"\"QFIM genérica para os experimentos de escalonamento.\"\"\"\n",
    "    theta = np.asarray(theta, dtype=float)\n",
    "    psi = circuit_statevector(circuit, theta)\n",
    "    psi /= np.linalg.norm(psi)\n",
    "    derivatives = np.empty((len(theta), len(psi)), dtype=np.complex128)\n",
    "    for theta_index in range(len(theta)):\n",
    "        plus = theta.copy()\n",
    "        minus = theta.copy()\n",
    "        plus[theta_index] += step\n",
    "        minus[theta_index] -= step\n",
    "        derivatives[theta_index] = (\n",
    "            circuit_statevector(circuit, plus)\n",
    "            - circuit_statevector(circuit, minus)\n",
    "        ) / (2.0 * step)\n",
    "    gram = derivatives.conj() @ derivatives.T\n",
    "    overlap = derivatives.conj() @ psi\n",
    "    qfim = 4.0 * np.real(gram - np.outer(overlap, overlap.conj()))\n",
    "    qfim = 0.5 * (qfim + qfim.T)\n",
    "    raw = np.sort(np.linalg.eigvalsh(qfim))[::-1]\n",
    "    values = np.maximum(raw, 0.0)\n",
    "    largest = max(float(values.max()), 0.0)\n",
    "    threshold = max(QFIM_ABSOLUTE_EIGEN_THRESHOLD, QFIM_RELATIVE_EIGEN_THRESHOLD * largest)\n",
    "    rank = int(np.sum(values > threshold))\n",
    "    positive = values[values > threshold]\n",
    "    if len(positive):\n",
    "        weights = positive / positive.sum()\n",
    "        effective_rank = float(np.exp(-np.sum(weights * np.log(weights))))\n",
    "    else:\n",
    "        effective_rank = 0.0\n",
    "    return {\n",
    "        \"qfim\": qfim,\n",
    "        \"eigenvalues\": values,\n",
    "        \"numerical_rank\": rank,\n",
    "        \"effective_rank\": effective_rank,\n",
    "        \"trace\": float(np.trace(qfim)),\n",
    "    }\n",
    "\n",
    "\n",
    "def generic_target_probability(circuit, theta, target_index):\n",
    "    state = circuit_statevector(circuit, theta)\n",
    "    return float(np.abs(state[target_index]) ** 2)\n",
    "\n",
    "\n",
    "def generic_coordinate_synthesis(circuit, periods, target_index, seed):\n",
    "    \"\"\"Versão compacta da busca coordenada para um circuito (n,k) genérico.\"\"\"\n",
    "    rng = np.random.default_rng(seed)\n",
    "    best_theta = None\n",
    "    best_probability = -np.inf\n",
    "    for restart in range(NK_SYNTHESIS_RESTARTS):\n",
    "        theta = np.asarray([\n",
    "            rng.uniform(0.0, period) for period in periods\n",
    "        ], dtype=float)\n",
    "        current = generic_target_probability(circuit, theta, target_index)\n",
    "        for _ in range(NK_SYNTHESIS_PASSES):\n",
    "            improved = False\n",
    "            for theta_index in rng.permutation(len(theta)):\n",
    "                grid = np.linspace(0.0, periods[theta_index], NK_SYNTHESIS_GRID_POINTS, endpoint=False)\n",
    "                values = []\n",
    "                for value in grid:\n",
    "                    test = theta.copy()\n",
    "                    test[theta_index] = value\n",
    "                    values.append(generic_target_probability(circuit, test, target_index))\n",
    "                local = int(np.argmax(values))\n",
    "                if values[local] > current + 1e-15:\n",
    "                    theta[theta_index] = float(grid[local])\n",
    "                    current = float(values[local])\n",
    "                    improved = True\n",
    "            if not improved:\n",
    "                break\n",
    "        if current > best_probability:\n",
    "            best_probability = current\n",
    "            best_theta = theta.copy()\n",
    "    return best_theta, float(best_probability)\n",
    "\n",
    "\n",
    "nk_scaling_rows = []\n",
    "nk_scaling_parameter_rows = []\n",
    "if RUN_NK_SCALING_TESTS:\n",
    "    for case_index, (n_value, k_value) in enumerate(NK_VALIDATION_CASES[:NK_MAX_CASES]):\n",
    "        circuit, case_structure, initial_case_qubits = build_tracked_dicke_ansatz(\n",
    "            n_value,\n",
    "            k_value,\n",
    "            RANDOM_SEED + 100 * n_value + k_value,\n",
    "        )\n",
    "        periods = np.asarray([\n",
    "            4.0 * np.pi if gate_type == \"CY\" else 2.0 * np.pi\n",
    "            for gate_type in case_structure.sort_values(\"theta_index\")[\"ansatz_gate_type\"]\n",
    "        ], dtype=float)\n",
    "\n",
    "        # Alvo determinístico: excitações nos primeiros k qubits, diferente do estado inicial.\n",
    "        target_bits_asset = np.zeros(n_value, dtype=int)\n",
    "        target_bits_asset[:k_value] = 1\n",
    "        target_qiskit = \"\".join(str(int(value)) for value in target_bits_asset)[::-1]\n",
    "        target_index = int(target_qiskit, 2)\n",
    "        theta_target, p_target = generic_coordinate_synthesis(\n",
    "            circuit,\n",
    "            periods,\n",
    "            target_index,\n",
    "            RANDOM_SEED + 26_000_000 + case_index,\n",
    "        )\n",
    "\n",
    "        span_rows = []\n",
    "        for theta_index, period in enumerate(periods):\n",
    "            grid = np.linspace(0.0, period, 13, endpoint=False)\n",
    "            values = []\n",
    "            for angle in grid:\n",
    "                test = theta_target.copy()\n",
    "                test[theta_index] = angle\n",
    "                values.append(generic_target_probability(circuit, test, target_index))\n",
    "            span_rows.append({\n",
    "                \"theta_index\": int(theta_index),\n",
    "                \"p_span\": float(np.ptp(values)),\n",
    "            })\n",
    "        span_frame = pd.DataFrame(span_rows)\n",
    "        maximum_span = max(float(span_frame[\"p_span\"].max()), 1e-12)\n",
    "        span_frame[\"relative_span\"] = span_frame[\"p_span\"] / maximum_span\n",
    "        span_frame[\"is_active\"] = (\n",
    "            span_frame[\"p_span\"].ge(1e-8)\n",
    "            & span_frame[\"relative_span\"].ge(0.05)\n",
    "        )\n",
    "        qfim_result = generic_qfim(circuit, theta_target)\n",
    "        active_indices = tuple(sorted(\n",
    "            span_frame.loc[span_frame[\"is_active\"], \"theta_index\"].astype(int).tolist()\n",
    "        ))\n",
    "\n",
    "        nk_scaling_rows.append({\n",
    "            \"n\": int(n_value),\n",
    "            \"k\": int(k_value),\n",
    "            \"n_parameters\": int(circuit.num_parameters),\n",
    "            \"target_bitstring_qiskit_order\": target_qiskit,\n",
    "            \"target_probability\": float(p_target),\n",
    "            \"n_active_from_sweep\": int(len(active_indices)),\n",
    "            \"active_parameters\": active_indices,\n",
    "            \"qfim_numerical_rank\": int(qfim_result[\"numerical_rank\"]),\n",
    "            \"qfim_effective_rank\": float(qfim_result[\"effective_rank\"]),\n",
    "            \"qfim_trace\": float(qfim_result[\"trace\"]),\n",
    "            \"initial_x_qubits\": tuple(initial_case_qubits),\n",
    "        })\n",
    "        span_frame.insert(0, \"n\", int(n_value))\n",
    "        span_frame.insert(1, \"k\", int(k_value))\n",
    "        nk_scaling_parameter_rows.extend(span_frame.to_dict(\"records\"))\n",
    "        print(\n",
    "            f\"(n,k)=({n_value},{k_value}): P(alvo)={p_target:.6f}, \"\n",
    "            f\"ativos={len(active_indices)}, rank QFIM={qfim_result['numerical_rank']}\"\n",
    "        )\n",
    "\n",
    "nk_scaling_summary_df = pd.DataFrame(nk_scaling_rows)\n",
    "nk_scaling_parameter_df = pd.DataFrame(nk_scaling_parameter_rows)\n",
    "if not nk_scaling_summary_df.empty:\n",
    "    display(nk_scaling_summary_df)\n",
    "    fig, ax = plt.subplots(figsize=(9, 5))\n",
    "    labels = [f\"({row.n},{row.k})\" for row in nk_scaling_summary_df.itertuples()]\n",
    "    x = np.arange(len(labels))\n",
    "    ax.plot(x, nk_scaling_summary_df[\"n_active_from_sweep\"], marker=\"o\", label=\"ativos pela varredura\")\n",
    "    ax.plot(x, nk_scaling_summary_df[\"qfim_numerical_rank\"], marker=\"s\", label=\"rank QFIM\")\n",
    "    ax.set_xticks(x)\n",
    "    ax.set_xticklabels(labels)\n",
    "    ax.set_xlabel(\"(n,k)\")\n",
    "    ax.set_ylabel(\"dimensão\")\n",
    "    ax.set_title(\"O caminho ativo e a QFIM escalam juntos?\")\n",
    "    ax.legend()\n",
    "    fig.tight_layout()\n",
    "    fig.savefig(FIGURE_DIR / \"nk_scaling_active_dimension_vs_qfim.png\", dpi=180)\n",
    "    plt.show()\n"
   ]
