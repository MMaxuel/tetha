    "                \"qfim\": np.asarray(saved[\"qfim\"], dtype=float),\n",
    "                \"eigenvalues\": np.asarray(\n",
    "                    saved[\"eigenvalues\"], dtype=float\n",
    "                ),\n",
    "                \"diagonal\": np.asarray(saved[\"diagonal\"], dtype=float),\n",
    "                \"numerical_threshold\": float(\n",
