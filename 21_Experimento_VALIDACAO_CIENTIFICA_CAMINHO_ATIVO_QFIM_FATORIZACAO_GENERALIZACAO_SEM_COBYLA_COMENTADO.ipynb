    "# Parte XIII — mapa de resposta dos 210 bitstrings e precursor da prova\n",
    "\n",
    "### Célula 28 — Cada bitstring possui um caminho ativo próprio?\n",
    "\n",
    "Em vez de otimizar separadamente 210 estados, esta célula perturba cada parâmetro em pontos controlados e mede a resposta de **todas as 210 probabilidades ao mesmo tempo**.\n",
    "\n",
    "Para cada bitstring $z$ e parâmetro $j$ é calculada uma resposta finita:\n",
    "\n",
    "$$\n",
    "R_{zj}\n",
    "=\n",
    "\\max\\left(\n",
    "|P_z(\\theta+h_je_j)-P_z(\\theta)|,\n",
    "|P_z(\\theta-h_je_j)-P_z(\\theta)|\n",
    "\\right).\n",
    "$$\n",
    "\n",
    "A resposta é avaliada em núcleos, pontos com ativos aleatórios e pontos totalmente aleatórios. Isso não substitui uma prova simbólica, mas mostra se o conjunto ativo depende do alvo e da região do espaço.\n",
    "\n",
    "A segunda parte calcula derivadas mistas de $\\log P(x^*)$. Se a probabilidade fatoriza como produto de funções unidimensionais, então:\n",
    "\n",
    "$$\n",
    "\\frac{\\partial^2\\log P(x^*)}{\\partial\\theta_i\\partial\\theta_j}=0,\n",
    "\\qquad i\\neq j.\n",
    "$$\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "40158113",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 28. ATLAS DE RESPOSTA DOS 210 BITSTRINGS E DERIVADAS MISTAS\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def valid_amplitudes_and_probabilities(theta):\n",
    "    \"\"\"Retorna amplitudes e probabilidades dos C(n,k) estados válidos em float64.\"\"\"\n",
    "    state = statevector_from_theta(theta)\n",
    "    amplitudes = np.asarray(state[valid_indices], dtype=np.complex128)\n",
    "    probabilities = np.abs(amplitudes) ** 2\n",
    "    return amplitudes, probabilities\n",
    "\n",
    "\n",
    "def target_response_theta(regime, point_index):\n",
    "    \"\"\"Gera referências para medir sensibilidade de todos os bitstrings.\"\"\"\n",
    "    rng = np.random.default_rng(\n",
    "        RANDOM_SEED + 22_000_000 + 10_000 * point_index\n",
    "        + sum(ord(character) for character in regime)\n",
    "    )\n",
    "    anchor_id = int(point_index % len(anchors_df))\n",
    "    theta_core = active_core_theta_by_anchor[anchor_id].copy()\n",
    "\n",
    "    if regime == \"core_anchors\":\n",
    "        return anchor_id, theta_core\n",
    "    if regime == \"active_random\":\n",
    "        theta = theta_core.copy()\n",
    "        for theta_index in ACTIVE_SET:\n",
    "            theta[theta_index] = rng.uniform(0.0, parameter_period(theta_index))\n",
    "        return anchor_id, theta\n",
    "    if regime == \"full_random\":\n",
    "        return anchor_id, random_theta_from_periods(rng)\n",
    "    raise ValueError(regime)\n",
    "\n",
    "\n",
    "target_response_rows = []\n",
    "\n",
    "if RUN_ALL_BITSTRING_RESPONSE_ATLAS:\n",
    "    for regime in TARGET_RESPONSE_REGIMES:\n",
    "        for point_index in range(TARGET_RESPONSE_POINTS_PER_REGIME):\n",
    "            anchor_id, theta_reference = target_response_theta(regime, point_index)\n",
    "            checkpoint = CHECKPOINT_DIR / (\n",
    "                f\"v21_target_response_{regime}_{point_index:03d}.npz\"\n",
    "            )\n",
    "            if checkpoint.exists():\n",
    "                saved = np.load(checkpoint)\n",
    "                base_probability = np.asarray(saved[\"base_probability\"], dtype=float)\n",
    "                response = np.asarray(saved[\"probability_response\"], dtype=float)\n",
    "                first_difference = np.asarray(saved[\"first_difference\"], dtype=float)\n",
    "                second_difference = np.asarray(saved[\"second_difference\"], dtype=float)\n",
    "            else:\n",
    "                _, base_probability = valid_amplitudes_and_probabilities(theta_reference)\n",
    "                response = np.zeros((len(valid_bitstrings), N_PARAMETERS), dtype=float)\n",
    "                first_difference = np.zeros_like(response)\n",
    "                second_difference = np.zeros_like(response)\n",
    "\n",
    "                for theta_index in range(N_PARAMETERS):\n",
    "                    period = parameter_period(theta_index)\n",
    "                    step = TARGET_RESPONSE_STEP_FRACTION * period\n",
    "                    theta_plus = theta_reference.copy()\n",
    "                    theta_minus = theta_reference.copy()\n",
    "                    theta_plus[theta_index] = (theta_plus[theta_index] + step) % period\n",
    "                    theta_minus[theta_index] = (theta_minus[theta_index] - step) % period\n",
    "                    _, p_plus = valid_amplitudes_and_probabilities(theta_plus)\n",
    "                    _, p_minus = valid_amplitudes_and_probabilities(theta_minus)\n",
    "                    response[:, theta_index] = np.maximum(\n",
    "                        np.abs(p_plus - base_probability),\n",
    "                        np.abs(p_minus - base_probability),\n",
    "                    )\n",
    "                    first_difference[:, theta_index] = 0.5 * (p_plus - p_minus)\n",
    "                    second_difference[:, theta_index] = p_plus - 2.0 * base_probability + p_minus\n",
    "\n",
    "                np.savez_compressed(\n",
    "                    checkpoint,\n",
    "                    theta=theta_reference,\n",
    "                    base_probability=base_probability,\n",
    "                    probability_response=response,\n",
    "                    first_difference=first_difference,\n",
    "                    second_difference=second_difference,\n",
    "                )\n",
    "\n",
    "            for valid_position, bitstring in enumerate(valid_bitstrings):\n",
    "                for theta_index in range(N_PARAMETERS):\n",
    "                    target_response_rows.append({\n",
    "                        \"regime\": regime,\n",
    "                        \"point_index\": int(point_index),\n",
    "                        \"anchor_id\": anchor_id,\n",
    "                        \"valid_rank\": int(valid_position + 1),\n",
