    "# ============================================================\n",
    "# 31. FAMÍLIA DE HAMILTONIANOS E ENUMERAÇÃO EXATA\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def enumerate_custom_portfolio(mu_value, sigma_value, q_value, label):\n",
    "    \"\"\"Enumera um novo Hamiltoniano no mesmo espaço n=10, k=4.\"\"\"\n",
    "    mu_value = np.asarray(mu_value, dtype=float)\n",
    "    sigma_value = np.asarray(sigma_value, dtype=float)\n",
    "    rows = []\n",
    "    for selected_indices in combinations(range(N_ASSETS), TARGET_K):\n",
    "        x = np.zeros(N_ASSETS, dtype=int)\n",
    "        x[list(selected_indices)] = 1\n",
    "        objective = float(\n",
    "            q_value * x @ sigma_value @ x\n",
    "            - (1.0 - q_value) * mu_value @ x\n",
    "            + RISK_FREE\n",
    "        )\n",
    "        bits_asset = bitstring_asset_order(x)\n",
    "        rows.append({\n",
    "            \"variant\": label,\n",
    "            \"q_value\": float(q_value),\n",
    "            \"x_asset_order\": tuple(int(v) for v in x),\n",
    "            \"bitstring_asset_order\": bits_asset,\n",
    "            \"bitstring_qiskit_order\": bits_asset[::-1],\n",
    "            \"selected_assets\": tuple(tickers[index] for index in selected_indices),\n",
    "            \"objective\": objective,\n",
    "        })\n",
    "    return pd.DataFrame(rows).sort_values(\n",
    "        [\"objective\", \"bitstring_asset_order\"]\n",
    "    ).reset_index(drop=True)\n",
    "\n",
    "\n",
    "def build_hamiltonian_variants():\n",
    "    \"\"\"Cria perturbações reproduzíveis e preserva simetria/PSD da covariância.\"\"\"\n",
    "    variants = []\n",
    "    for q_value in HAMILTONIAN_RISK_VALUES:\n",
    "        variants.append((f\"risk_q_{q_value:.2f}\", mu.copy(), sigma.copy(), q_value))\n",
    "\n",
    "    diagonal = np.diag(np.diag(sigma))\n",
    "    for alpha in HAMILTONIAN_SHRINKAGE_VALUES:\n",
    "        sigma_variant = (1.0 - alpha) * sigma + alpha * diagonal\n",
    "        variants.append((f\"covariance_shrinkage_{alpha:.2f}\", mu.copy(), sigma_variant, Q_VALUE))\n",
    "\n",
    "    mu_scale = max(float(np.std(mu)), 1e-8)\n",
    "    trace_scale = max(float(np.trace(sigma)) / N_ASSETS, 1e-8)\n",
    "    for seed in HAMILTONIAN_PERTURBATION_SEEDS:\n",
    "        rng = np.random.default_rng(seed)\n",
    "        return_direction = rng.normal(size=N_ASSETS)\n",
    "        return_direction -= return_direction.mean()\n",
    "        return_direction /= max(np.linalg.norm(return_direction), 1e-12)\n",
    "        mu_variant = mu + 0.25 * mu_scale * return_direction\n",
    "\n",
    "        matrix = rng.normal(size=(N_ASSETS, N_ASSETS))\n",
    "        psd = matrix @ matrix.T\n",
    "        psd *= (0.05 * trace_scale * N_ASSETS) / max(np.trace(psd), 1e-12)\n",
    "        sigma_variant = 0.5 * (sigma + sigma.T) + psd\n",
    "        variants.append((f\"psd_return_perturbation_{seed}\", mu_variant, sigma_variant, Q_VALUE))\n",
    "    return variants\n",
    "\n",
    "\n",
    "hamiltonian_variant_rows = []\n",
    "hamiltonian_variant_enumerations = {}\n",
    "if RUN_HAMILTONIAN_VARIANTS:\n",
    "    for label, mu_variant, sigma_variant, q_value in build_hamiltonian_variants():\n",
    "        frame = enumerate_custom_portfolio(mu_variant, sigma_variant, q_value, label)\n",
    "        hamiltonian_variant_enumerations[label] = frame\n",
    "        best = frame.iloc[0]\n",
    "        hamiltonian_variant_rows.append({\n",
    "            \"variant\": label,\n",
    "            \"q_value\": float(q_value),\n",
    "            \"exact_energy\": float(best[\"objective\"]),\n",
    "            \"optimal_bitstring_asset_order\": str(best[\"bitstring_asset_order\"]),\n",
    "            \"optimal_bitstring_qiskit_order\": str(best[\"bitstring_qiskit_order\"]),\n",
    "            \"selected_assets\": tuple(best[\"selected_assets\"]),\n",
    "            \"same_as_baseline\": bool(str(best[\"bitstring_qiskit_order\"]) in optimal_set),\n",
    "        })\n",
    "\n",
    "hamiltonian_variants_df = pd.DataFrame(hamiltonian_variant_rows)\n",
    "if not hamiltonian_variants_df.empty:\n",
    "    display(hamiltonian_variants_df)\n",
    "    print(\n",
    "        \"Bitstrings ótimos distintos:\",\n",
    "        hamiltonian_variants_df[\"optimal_bitstring_qiskit_order\"].nunique(),\n",
    "    )\n"
   ]
