    "# ============================================================\n",
    "# 32. SÍNTESE DETERMINÍSTICA E TESTES DOS NOVOS BITSTRINGS-ALVO\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def target_probability_from_theta(theta, target_bitstring):\n",
    "    \"\"\"Probabilidade exata de um bitstring na ordem Qiskit.\"\"\"\n",
    "    target_index = label_to_index[str(target_bitstring)]\n",
    "    state = statevector_from_theta(theta)\n",
    "    return float(np.abs(state[target_index]) ** 2)\n",
    "\n",
    "\n",
    "def coordinate_grid_synthesis(\n",
    "    target_bitstring,\n",
    "    initial_thetas,\n",
    "    restarts,\n",
    "    passes,\n",
    "    grid_points,\n",
    "    checkpoint_name,\n",
    "):\n",
    "    \"\"\"Busca coordenada determinística em grades periódicas; não usa COBYLA.\"\"\"\n",
    "    checkpoint = CHECKPOINT_DIR / checkpoint_name\n",
    "    if checkpoint.exists():\n",
    "        saved = np.load(checkpoint, allow_pickle=True)\n",
    "        return {\n",
    "            \"theta\": np.asarray(saved[\"theta\"], dtype=float),\n",
    "            \"target_probability\": float(saved[\"target_probability\"]),\n",
    "            \"history\": list(saved[\"history\"].tolist()),\n",
    "        }\n",
    "\n",
    "    rng = np.random.default_rng(\n",
    "        RANDOM_SEED + 25_000_000 + int(target_bitstring, 2)\n",
    "    )\n",
    "    seed_list = [np.asarray(theta, dtype=float).copy() for theta in initial_thetas]\n",
    "    while len(seed_list) < restarts:\n",
    "        seed_list.append(random_theta_from_periods(rng))\n",
    "    seed_list = seed_list[:restarts]\n",
    "\n",
    "    best_theta = None\n",
    "    best_probability = -np.inf\n",
    "    history = []\n",
    "\n",
    "    for restart_index, theta_start in enumerate(seed_list):\n",
    "        theta = theta_start.copy()\n",
    "        current_probability = target_probability_from_theta(theta, target_bitstring)\n",
    "        for pass_index in range(passes):\n",
    "            order = rng.permutation(N_PARAMETERS)\n",
    "            improved_in_pass = False\n",
    "            for theta_index in order:\n",
    "                period = parameter_period(int(theta_index))\n",
    "                grid = np.linspace(0.0, period, grid_points, endpoint=False)\n",
    "                candidates = np.unique(np.concatenate([grid, [theta[theta_index] % period]]))\n",
    "                values = []\n",
    "                for candidate in candidates:\n",
    "                    theta_test = theta.copy()\n",
    "                    theta_test[theta_index] = float(candidate)\n",
    "                    values.append(target_probability_from_theta(theta_test, target_bitstring))\n",
    "                best_local = int(np.argmax(values))\n",
    "                if values[best_local] > current_probability + 1e-15:\n",
    "                    theta[theta_index] = float(candidates[best_local])\n",
    "                    current_probability = float(values[best_local])\n",
    "                    improved_in_pass = True\n",
    "            history.append({\n",
    "                \"restart\": int(restart_index),\n",
    "                \"pass\": int(pass_index),\n",
    "                \"target_probability\": float(current_probability),\n",
    "            })\n",
    "            if not improved_in_pass:\n",
    "                break\n",
    "\n",
    "        if current_probability > best_probability:\n",
    "            best_probability = float(current_probability)\n",
    "            best_theta = theta.copy()\n",
    "\n",
    "    np.savez_compressed(\n",
    "        checkpoint,\n",
    "        theta=best_theta,\n",
    "        target_probability=best_probability,\n",
    "        history=np.asarray(history, dtype=object),\n",
    "    )\n",
    "    return {\n",
    "        \"theta\": best_theta,\n",
    "        \"target_probability\": best_probability,\n",
    "        \"history\": history,\n",
    "    }\n",
    "\n",
    "\n",
    "def target_parameter_spans(theta_reference, target_bitstring, grid_points):\n",
    "    \"\"\"Varre todos os parâmetros e retorna a amplitude da probabilidade do alvo.\"\"\"\n",
    "    rows = []\n",
    "    for theta_index in range(N_PARAMETERS):\n",
    "        period = parameter_period(theta_index)\n",
    "        grid = np.linspace(0.0, period, grid_points, endpoint=False)\n",
    "        probabilities = []\n",
    "        for value in grid:\n",
    "            theta_test = theta_reference.copy()\n",
    "            theta_test[theta_index] = float(value)\n",
    "            probabilities.append(target_probability_from_theta(theta_test, target_bitstring))\n",
    "        rows.append({\n",
    "            \"theta_index\": int(theta_index),\n",
    "            \"p_min\": float(np.min(probabilities)),\n",
    "            \"p_max\": float(np.max(probabilities)),\n",
    "            \"p_span\": float(np.ptp(probabilities)),\n",
    "            \"best_angle\": float(grid[int(np.argmax(probabilities))]),\n",
    "            \"worst_angle\": float(grid[int(np.argmin(probabilities))]),\n",
    "        })\n",
    "    frame = pd.DataFrame(rows)\n",
    "    maximum_span = max(float(frame[\"p_span\"].max()), TARGET_SYNTHESIS_ACTIVITY_ABS_THRESHOLD)\n",
    "    frame[\"relative_span\"] = frame[\"p_span\"] / maximum_span\n",
    "    frame[\"is_active_for_target\"] = (\n",
    "        frame[\"p_span\"].ge(TARGET_SYNTHESIS_ACTIVITY_ABS_THRESHOLD)\n",
    "        & frame[\"relative_span\"].ge(TARGET_SYNTHESIS_ACTIVITY_REL_THRESHOLD)\n",
    "    )\n",
    "    return frame\n",
    "\n",
    "\n",
    "def target_factorization_trials(theta_reference, target_bitstring, active_indices, n_trials):\n",
    "    \"\"\"Testa o produto unidimensional para um alvo sintetizado.\"\"\"\n",
    "    active_indices = tuple(sorted(map(int, active_indices)))\n",
    "    if len(active_indices) < 2:\n",
    "        return pd.DataFrame()\n",
    "    rng = np.random.default_rng(\n",
    "        RANDOM_SEED + 25_500_000 + int(target_bitstring, 2)\n",
    "    )\n",
    "    p0 = target_probability_from_theta(theta_reference, target_bitstring)\n",
    "    log_p0 = float(np.log(max(p0, ACTIVE_FACTOR_NUMERIC_FLOOR)))\n",
    "    rows = []\n",
    "    maximum_subset = min(len(active_indices), 7)\n",
    "    for subset_size in range(2, maximum_subset + 1):\n",
    "        for trial_index in range(n_trials):\n",
    "            subset = tuple(sorted(\n",
    "                int(value) for value in rng.choice(\n",
    "                    active_indices, size=subset_size, replace=False\n",
    "                )\n",
    "            ))\n",
    "            targets = {\n",
    "                theta_index: float(rng.uniform(0.0, parameter_period(theta_index)))\n",
    "                for theta_index in subset\n",
    "            }\n",
    "            theta_joint = theta_reference.copy()\n",
    "            for theta_index, value in targets.items():\n",
    "                theta_joint[theta_index] = value\n",
    "            observed = target_probability_from_theta(theta_joint, target_bitstring)\n",
    "            log_prediction = log_p0\n",
    "            for theta_index, value in targets.items():\n",
    "                theta_single = theta_reference.copy()\n",
    "                theta_single[theta_index] = value\n",
    "                p_single = target_probability_from_theta(theta_single, target_bitstring)\n",
    "                log_prediction += np.log(max(p_single, ACTIVE_FACTOR_NUMERIC_FLOOR)) - log_p0\n",
    "            predicted = float(np.exp(np.clip(log_prediction, -745.0, 700.0)))\n",
    "            rows.append({\n",
    "                \"target_bitstring\": str(target_bitstring),\n",
    "                \"subset_size\": int(subset_size),\n",
    "                \"trial_index\": int(trial_index),\n",
    "                \"subset\": subset,\n",
    "                \"p_observed\": float(observed),\n",
    "                \"p_predicted\": float(predicted),\n",
    "                \"absolute_error\": float(abs(observed - predicted)),\n",
    "                \"symmetric_relative_error\": float(\n",
    "                    2.0 * abs(observed - predicted)\n",
    "                    / max(abs(observed) + abs(predicted), ACTIVE_FACTOR_NUMERIC_FLOOR)\n",
    "                ),\n",
    "            })\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "target_synthesis_rows = []\n",
    "target_synthesis_parameter_frames = []\n",
    "target_synthesis_factor_frames = []\n",
    "target_synthesis_qfim_rows = []\n",
    "target_synthesis_theta_by_bitstring = {}\n",
    "\n",
    "if RUN_TARGET_SYNTHESIS and not hamiltonian_variants_df.empty:\n",
    "    unique_targets = list(dict.fromkeys(\n",
    "        hamiltonian_variants_df[\"optimal_bitstring_qiskit_order\"].astype(str).tolist()\n",
    "    ))[:TARGET_SYNTHESIS_MAX_TARGETS]\n",
    "    initial_thetas = [\n",
    "        active_core_theta_by_anchor[int(index % len(anchors_df))]\n",
    "        for index in range(min(len(anchors_df), TARGET_SYNTHESIS_RESTARTS))\n",
    "    ]\n",
    "\n",
    "    for target_order, target_bitstring in enumerate(unique_targets):\n",
    "        synthesis = coordinate_grid_synthesis(\n",
    "            target_bitstring=target_bitstring,\n",
    "            initial_thetas=initial_thetas,\n",
    "            restarts=TARGET_SYNTHESIS_RESTARTS,\n",
    "            passes=TARGET_SYNTHESIS_PASSES,\n",
    "            grid_points=TARGET_SYNTHESIS_GRID_POINTS,\n",
    "            checkpoint_name=f\"v21_target_synthesis_{target_bitstring}.npz\",\n",
    "        )\n",
    "        theta_target = synthesis[\"theta\"]\n",
    "        target_synthesis_theta_by_bitstring[target_bitstring] = theta_target\n",
    "        span_frame = target_parameter_spans(\n",
    "            theta_target,\n",
    "            target_bitstring,\n",
    "            TARGET_SYNTHESIS_ACTIVITY_GRID_POINTS,\n",
    "        )\n",
    "        span_frame.insert(0, \"target_bitstring\", target_bitstring)\n",
    "        target_synthesis_parameter_frames.append(span_frame)\n",
    "        active_for_target = tuple(sorted(\n",
    "            span_frame.loc[span_frame[\"is_active_for_target\"], \"theta_index\"].astype(int).tolist()\n",
    "        ))\n",
    "\n",
    "        qfim_result = pure_state_qfim(theta_target)\n",
    "        target_synthesis_qfim_rows.append({\n",
    "            \"target_bitstring\": target_bitstring,\n",
    "            \"target_probability\": float(synthesis[\"target_probability\"]),\n",
    "            \"numerical_rank\": int(qfim_result[\"numerical_rank\"]),\n",
    "            \"effective_rank\": float(qfim_result[\"effective_rank\"]),\n",
    "            \"trace\": float(qfim_result[\"trace\"]),\n",
    "            \"n_active_from_sweep\": int(len(active_for_target)),\n",
    "            \"active_parameters_from_sweep\": active_for_target,\n",
    "        })\n",
    "\n",
    "        factor_frame = target_factorization_trials(\n",
    "            theta_target,\n",
    "            target_bitstring,\n",
    "            active_for_target,\n",
    "            TARGET_SYNTHESIS_FACTOR_TRIALS,\n",
    "        )\n",
    "        if not factor_frame.empty:\n",
    "            target_synthesis_factor_frames.append(factor_frame)\n",
    "\n",
    "        target_synthesis_rows.append({\n",
    "            \"target_order\": int(target_order),\n",
    "            \"target_bitstring\": target_bitstring,\n",
    "            \"target_probability\": float(synthesis[\"target_probability\"]),\n",
    "            \"n_history_rows\": int(len(synthesis[\"history\"])),\n",
    "            \"n_active_from_sweep\": int(len(active_for_target)),\n",
    "            \"active_parameters_from_sweep\": active_for_target,\n",
    "        })\n",
    "        print(\n",
    "            f\"alvo {target_bitstring}: P={synthesis['target_probability']:.6f}, \"\n",
    "            f\"ativos={active_for_target}\"\n",
    "        )\n",
    "\n",
    "target_synthesis_df = pd.DataFrame(target_synthesis_rows)\n",
    "target_synthesis_parameter_df = (\n",
    "    pd.concat(target_synthesis_parameter_frames, ignore_index=True)\n",
    "    if target_synthesis_parameter_frames else pd.DataFrame()\n",
    ")\n",
    "target_synthesis_factor_df = (\n",
    "    pd.concat(target_synthesis_factor_frames, ignore_index=True)\n",
    "    if target_synthesis_factor_frames else pd.DataFrame()\n",
    ")\n",
    "target_synthesis_qfim_df = pd.DataFrame(target_synthesis_qfim_rows)\n",
