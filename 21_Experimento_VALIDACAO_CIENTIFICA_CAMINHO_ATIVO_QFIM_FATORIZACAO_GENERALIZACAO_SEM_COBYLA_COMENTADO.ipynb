    "# Parte XIV — fatorização da distribuição completa\n",
    "\n",
    "### Célula 29 — O produto explica somente $P(x^*)$ ou todos os 210 estados?\n",
    "\n",
    "A versão 20.4 demonstrou:\n",
    "\n",
    "$$\n",
    "P(x^*)\\approx P_0\\prod_j\\frac{P_j(x^*)}{P_0}.\n",
    "$$\n",
    "\n",
    "Agora a mesma fórmula é aplicada separadamente a cada bitstring válido:\n",
    "\n",
    "$$\n",
    "\\widehat P_z(\\theta_S)\n",
    "\\propto\n",
    "P_z(\\theta_0)\n",
    "\\prod_{j\\in S}\n",
    "\\frac{P_z(\\theta_j)}{P_z(\\theta_0)}.\n",
    "$$\n",
    "\n",
    "Depois da normalização, a distribuição prevista é comparada à distribuição observada por TVD, divergência de Jensen–Shannon, distância de Hellinger, energia esperada e preservação do estado dominante.\n",
    "\n",
    "Este teste é crucial: uma fatorização perfeita apenas para o ótimo não implica fatorização do statevector nem da distribuição inteira.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e949b1b0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 29. FATORIZAÇÃO MULTIPLICATIVA DA DISTRIBUIÇÃO COMPLETA\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def normalize_probability_vector(probability, floor=0.0):\n",
    "    \"\"\"Normaliza um vetor não negativo e falha de forma explícita se a massa for nula.\"\"\"\n",
    "    probability = np.asarray(probability, dtype=float)\n",
    "    probability = np.maximum(probability, floor)\n",
    "    mass = float(probability.sum())\n",
    "    if not np.isfinite(mass) or mass <= 0.0:\n",
    "        raise RuntimeError(\"Distribuição sem massa finita.\")\n",
    "    return probability / mass\n",
    "\n",
    "\n",
    "def hellinger_distance(p, q):\n",
    "    \"\"\"Distância de Hellinger entre distribuições normalizadas.\"\"\"\n",
    "    p = normalize_probability_vector(p)\n",
    "    q = normalize_probability_vector(q)\n",
    "    return float(np.sqrt(0.5 * np.sum((np.sqrt(p) - np.sqrt(q)) ** 2)))\n",
    "\n",
    "\n",
    "def distribution_reference_theta(reference_id):\n",
    "    \"\"\"Gera referências com suporte mais amplo que o núcleo quase determinístico.\"\"\"\n",
    "    anchor_id = int(reference_id % len(anchors_df))\n",
    "    theta = active_core_theta_by_anchor[anchor_id].copy()\n",
    "    if reference_id == 0:\n",
    "        return \"core\", anchor_id, theta\n",
    "    rng = np.random.default_rng(RANDOM_SEED + 23_000_000 + reference_id)\n",
    "    for theta_index in ACTIVE_SET:\n",
    "        theta[theta_index] = rng.uniform(0.0, parameter_period(theta_index))\n",
    "    return \"active_random\", anchor_id, theta\n",
    "\n",
    "\n",
    "def run_distribution_factor_trials(reference_id):\n",
    "    \"\"\"Compara a distribuição observada ao produto das respostas individuais.\"\"\"\n",
    "    path = CHECKPOINT_DIR / f\"v21_full_distribution_factor_reference_{reference_id:03d}.pkl\"\n",
    "    if path.exists():\n",
    "        return pd.read_pickle(path)\n",
    "\n",
    "    reference_kind, anchor_id, theta_reference = distribution_reference_theta(reference_id)\n",
    "    rng = np.random.default_rng(RANDOM_SEED + 23_500_000 + reference_id)\n",
    "    _, p0 = valid_amplitudes_and_probabilities(theta_reference)\n",
    "    p0 = normalize_probability_vector(p0)\n",
    "    log_p0 = np.log(np.maximum(p0, DISTRIBUTION_FACTOR_FLOOR))\n",
    "    rows = []\n",
    "\n",
    "    for subset_size in range(2, len(ACTIVE_SET) + 1):\n",
    "        for trial_index in range(DISTRIBUTION_FACTOR_TRIALS_PER_SIZE):\n",
    "            subset = tuple(sorted(\n",
    "                int(value) for value in rng.choice(\n",
    "                    ACTIVE_SET, size=subset_size, replace=False\n",
    "                )\n",
    "            ))\n",
    "            targets = {\n",
    "                theta_index: float(rng.uniform(0.0, parameter_period(theta_index)))\n",
    "                for theta_index in subset\n",
    "            }\n",
    "\n",
    "            theta_joint = theta_reference.copy()\n",
    "            for theta_index, target in targets.items():\n",
    "                theta_joint[theta_index] = target\n",
    "            _, observed = valid_amplitudes_and_probabilities(theta_joint)\n",
    "            observed = normalize_probability_vector(observed)\n",
    "\n",
    "            log_prediction = log_p0.copy()\n",
    "            for theta_index, target in targets.items():\n",
    "                theta_single = theta_reference.copy()\n",
    "                theta_single[theta_index] = target\n",
    "                _, p_single = valid_amplitudes_and_probabilities(theta_single)\n",
    "                p_single = normalize_probability_vector(p_single)\n",
    "                log_prediction += (\n",
    "                    np.log(np.maximum(p_single, DISTRIBUTION_FACTOR_FLOOR))\n",
    "                    - log_p0\n",
    "                )\n",
    "\n",
    "            # Normalização estável em log-space.\n",
    "            log_prediction -= float(np.max(log_prediction))\n",
    "            predicted = np.exp(np.clip(log_prediction, -745.0, 0.0))\n",
    "            predicted = normalize_probability_vector(predicted)\n",
    "\n",
    "            reliable = (\n",
    "                (p0 > DISTRIBUTION_FACTOR_RELIABLE_THRESHOLD)\n",
    "                & (observed > DISTRIBUTION_FACTOR_RELIABLE_THRESHOLD)\n",
    "                & (predicted > DISTRIBUTION_FACTOR_RELIABLE_THRESHOLD)\n",
    "            )\n",
    "            log_rmse = (\n",
    "                float(np.sqrt(np.mean((np.log10(observed[reliable]) - np.log10(predicted[reliable])) ** 2)))\n",
    "                if np.any(reliable)\n",
    "                else np.nan\n",
    "            )\n",
    "            observed_energy = float(observed @ valid_objectives)\n",
    "            predicted_energy = float(predicted @ valid_objectives)\n",
    "            observed_top = int(np.argmax(observed))\n",
    "            predicted_top = int(np.argmax(predicted))\n",
    "\n",
    "            rows.append({\n",
    "                \"reference_id\": int(reference_id),\n",
    "                \"reference_kind\": reference_kind,\n",
    "                \"anchor_id\": anchor_id,\n",
    "                \"subset_size\": int(subset_size),\n",
    "                \"trial_index\": int(trial_index),\n",
    "                \"subset\": subset,\n",
    "                \"targets\": targets,\n",
    "                \"tvd\": total_variation_distance(observed, predicted),\n",
    "                \"jsd\": jensen_shannon_divergence(observed, predicted),\n",
    "                \"hellinger\": hellinger_distance(observed, predicted),\n",
    "                \"rmse\": float(np.sqrt(np.mean((observed - predicted) ** 2))),\n",
    "                \"max_abs_error\": float(np.max(np.abs(observed - predicted))),\n",
    "                \"log10_rmse_reliable\": log_rmse,\n",
    "                \"reliable_support_fraction\": float(np.mean(reliable)),\n",
    "                \"observed_expected_energy\": observed_energy,\n",
    "                \"predicted_expected_energy\": predicted_energy,\n",
    "                \"absolute_energy_error\": float(abs(observed_energy - predicted_energy)),\n",
    "                \"observed_top_bitstring\": str(valid_bitstrings[observed_top]),\n",
    "                \"predicted_top_bitstring\": str(valid_bitstrings[predicted_top]),\n",
    "                \"top_bitstring_equal\": bool(observed_top == predicted_top),\n",
    "                \"observed_p_optimal\": float(observed[:len(exact_qiskit_bitstrings)].sum()),\n",
    "                \"predicted_p_optimal\": float(predicted[:len(exact_qiskit_bitstrings)].sum()),\n",
    "            })\n",
    "\n",
    "    frame = pd.DataFrame(rows)\n",
    "    frame.to_pickle(path)\n",
    "    return frame\n",
    "\n",
    "\n",
    "full_distribution_factor_trials_df = pd.DataFrame()\n",
    "full_distribution_factor_summary_df = pd.DataFrame()\n",
    "\n",
    "if RUN_FULL_DISTRIBUTION_FACTORIZATION:\n",
    "    frames = [\n",
    "        run_distribution_factor_trials(reference_id)\n",
    "        for reference_id in range(DISTRIBUTION_FACTOR_REFERENCES)\n",
    "    ]\n",
    "    full_distribution_factor_trials_df = pd.concat(frames, ignore_index=True)\n",
    "    full_distribution_factor_summary_df = full_distribution_factor_trials_df.groupby(\n",
    "        [\"reference_kind\", \"subset_size\"], as_index=False\n",
    "    ).agg(\n",
    "        n_trials=(\"trial_index\", \"count\"),\n",
    "        tvd_median=(\"tvd\", \"median\"),\n",
    "        tvd_q95=(\"tvd\", lambda s: float(s.quantile(0.95))),\n",
    "        jsd_median=(\"jsd\", \"median\"),\n",
    "        hellinger_median=(\"hellinger\", \"median\"),\n",
    "        max_abs_error_q95=(\"max_abs_error\", lambda s: float(s.quantile(0.95))),\n",
    "        absolute_energy_error_median=(\"absolute_energy_error\", \"median\"),\n",
    "        top_bitstring_accuracy=(\"top_bitstring_equal\", \"mean\"),\n",
    "        reliable_support_fraction_median=(\"reliable_support_fraction\", \"median\"),\n",
    "    )\n",
    "    display(full_distribution_factor_summary_df)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(9, 5))\n",
    "    for reference_kind, group in full_distribution_factor_summary_df.groupby(\"reference_kind\"):\n",
    "        ax.plot(group[\"subset_size\"], group[\"tvd_median\"], marker=\"o\", label=reference_kind)\n",
    "    ax.set_xlabel(\"número de parâmetros ativos modificados\")\n",
    "    ax.set_ylabel(\"TVD mediana da distribuição completa\")\n",
    "    ax.set_title(\"A fatorização explica os 210 portfólios?\")\n",
    "    ax.set_xticks(range(2, len(ACTIVE_SET) + 1))\n",
    "    ax.legend()\n",
    "    fig.tight_layout()\n",
    "    fig.savefig(FIGURE_DIR / \"full_distribution_factorization_tvd.png\", dpi=180)\n",
    "    plt.show()\n"
   ]
