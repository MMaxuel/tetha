    "# ============================================================\n",
    "# 34. ROBUSTEZ A SHOTS E MODELO OPCIONAL DE RUÍDO\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "def sampled_distribution(probability, shots, rng):\n",
    "    \"\"\"Amostra uma distribuição multinomial e retorna frequências relativas.\"\"\"\n",
    "    probability = normalize_probability_vector(probability)\n",
    "    counts = rng.multinomial(int(shots), probability)\n",
    "    return counts.astype(float) / float(shots)\n",
    "\n",
    "\n",
    "shot_rows = []\n",
    "if RUN_SHOT_ROBUSTNESS:\n",
    "    scenarios = []\n",
    "    core_theta = active_core_theta_by_anchor[0].copy()\n",
    "    _, core_probability = valid_amplitudes_and_probabilities(core_theta)\n",
    "    scenarios.append((\"active_core\", core_probability))\n",
    "\n",
    "    rng_scenario = np.random.default_rng(RANDOM_SEED + 27_000_000)\n",
    "    random_theta = random_theta_from_periods(rng_scenario)\n",
    "    _, random_probability = valid_amplitudes_and_probabilities(random_theta)\n",
    "    scenarios.append((\"all_random\", random_probability))\n",
    "\n",
    "    rescue_theta = random_theta.copy()\n",
    "    rescue_theta[list(ACTIVE_SET)] = core_theta[list(ACTIVE_SET)]\n",
    "    _, rescue_probability = valid_amplitudes_and_probabilities(rescue_theta)\n",
    "    scenarios.append((\"active_core_rescue\", rescue_probability))\n",
    "\n",
    "    for scenario, exact_probability in scenarios:\n",
    "        exact_probability = normalize_probability_vector(exact_probability)\n",
    "        exact_top = int(np.argmax(exact_probability))\n",
    "        for shots in SHOT_VALUES:\n",
    "            for repeat in range(SHOT_REPEATS):\n",
    "                rng = np.random.default_rng(\n",
    "                    RANDOM_SEED + 27_500_000 + shots * 1000 + repeat\n",
    "                    + sum(ord(character) for character in scenario)\n",
    "                )\n",
    "                empirical = sampled_distribution(exact_probability, shots, rng)\n",
    "                empirical_top = int(np.argmax(empirical))\n",
    "                shot_rows.append({\n",
    "                    \"scenario\": scenario,\n",
    "                    \"shots\": int(shots),\n",
    "                    \"repeat\": int(repeat),\n",
    "                    \"tvd_to_exact\": total_variation_distance(empirical, exact_probability),\n",
    "                    \"jsd_to_exact\": jensen_shannon_divergence(empirical, exact_probability),\n",
    "                    \"top_bitstring_recovered\": bool(empirical_top == exact_top),\n",
    "                    \"exact_top_bitstring\": str(valid_bitstrings[exact_top]),\n",
    "                    \"empirical_top_bitstring\": str(valid_bitstrings[empirical_top]),\n",
    "                    \"p_optimal_error\": float(\n",
    "                        abs(empirical[:len(exact_qiskit_bitstrings)].sum()\n",
    "                            - exact_probability[:len(exact_qiskit_bitstrings)].sum())\n",
    "                    ),\n",
    "                })\n",
    "\n",
    "shot_robustness_df = pd.DataFrame(shot_rows)\n",
    "shot_robustness_summary_df = pd.DataFrame()\n",
    "if not shot_robustness_df.empty:\n",
    "    shot_robustness_summary_df = shot_robustness_df.groupby(\n",
    "        [\"scenario\", \"shots\"], as_index=False\n",
    "    ).agg(\n",
    "        tvd_median=(\"tvd_to_exact\", \"median\"),\n",
    "        tvd_q95=(\"tvd_to_exact\", lambda s: float(s.quantile(0.95))),\n",
    "        jsd_median=(\"jsd_to_exact\", \"median\"),\n",
    "        top_recovery_rate=(\"top_bitstring_recovered\", \"mean\"),\n",
    "        p_optimal_error_median=(\"p_optimal_error\", \"median\"),\n",
    "        p_optimal_error_q95=(\"p_optimal_error\", lambda s: float(s.quantile(0.95))),\n",
    "    )\n",
    "    display(shot_robustness_summary_df)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(9, 5))\n",
    "    for scenario, group in shot_robustness_summary_df.groupby(\"scenario\"):\n",
    "        ax.plot(group[\"shots\"], group[\"tvd_median\"], marker=\"o\", label=scenario)\n",
    "    ax.set_xscale(\"log\")\n",
    "    ax.set_yscale(\"log\")\n",
    "    ax.set_xlabel(\"shots\")\n",
    "    ax.set_ylabel(\"TVD mediana para a distribuição exata\")\n",
    "    ax.set_title(\"Piso estatístico imposto pelo número de shots\")\n",
    "    ax.legend()\n",
    "    fig.tight_layout()\n",
    "    fig.savefig(FIGURE_DIR / \"shot_robustness_tvd.png\", dpi=180)\n",
    "    plt.show()\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Teste opcional com Aer. Falhas de importação não interrompem o notebook.\n",
    "# ------------------------------------------------------------\n",
    "aer_noise_rows = []\n",
    "aer_noise_status = \"disabled\"\n",
    "if RUN_AER_NOISE_TESTS:\n",
    "    try:\n",
    "        from qiskit_aer import AerSimulator\n",
    "        from qiskit_aer.noise import NoiseModel, depolarizing_error\n",
    "\n",
    "        aer_noise_status = \"executed\"\n",
    "        theta_reference = active_core_theta_by_anchor[0].copy()\n",
    "        full_bound = ansatz.assign_parameters(theta_reference, inplace=False)\n",
    "        reduced_binding = {\n",
    "            active_parameter_objects[theta_index]: float(theta_reference[theta_index])\n",
